{
 "$schema":"https://openapi.vercel.sh/vercel.json",
 "buildCommand":"npm run build",
 "outputDirectory":"dist",
 "framework":null,
 "functions":{"api/entry.js":{"includeFiles":"roadmap/entry/index.html"}},
 "rewrites":[{"source":"/roadmap/entry","destination":"/roadmap/entry/index.html"},{"source":"/roadmap/:slug","destination":"/api/entry?slug=:slug"},{"source":"/sitemap.xml","destination":"/api/sitemap"},{"source":"/consult","destination":"/consult.html"}],
 "headers":[{"source":"/(.*)","headers":[{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"},{"key":"X-Frame-Options","value":"DENY"}]},{"source":"/admin/(.*)","headers":[{"key":"X-Robots-Tag","value":"noindex, nofollow"},{"key":"Cache-Control","value":"no-store"}]},{"source":"/assets/roadmap-config.js","headers":[{"key":"Cache-Control","value":"no-store"}]}]
}
